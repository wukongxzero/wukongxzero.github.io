---
const {
  title = "Pavan Velagaleti | Robotics",
  description = "Robotics portfolio — real-time control, embedded systems, simulation-first development.",
} = Astro.props;

const pathname = Astro.url?.pathname ?? "/";
const isHome = pathname === "/" || pathname === "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />

    <style>
      :root{
        --bg:#ffffff;
        --fg:#0b0d12;
        --muted:rgba(11,13,18,.65);
        --line:rgba(11,13,18,.10);
        --card:rgba(11,13,18,.03);
        --shadow:0 14px 42px rgba(0,0,0,.08);

        --link:#0a66c2;

        --radius:18px;
        --max:1100px;

        --navH: 72px;
      }

      :root[data-theme="dark"]{
        --bg:#0b1220;
        --fg:#f3f4f6;
        --muted:rgba(243,244,246,.78);
        --line:rgba(243,244,246,.16);
        --card:rgba(243,244,246,.08);
        --shadow:0 18px 55px rgba(0,0,0,.50);

        --link:#7dd3fc;
      }

      *{ box-sizing:border-box }
      html,body{ height:100% }
      html{ scroll-behavior:smooth; }

      body{
        margin:0;
        background:var(--bg);
        color:var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        line-height:1.45;
        transition: background .25s ease, color .25s ease;
      }

      /* Global readable defaults for prose */
      p, li{ color: var(--muted); }
      h1, h2, h3, h4{ color: var(--fg); }

      /* Links: keep nice in prose, prevent browser purple */
      a{
        color:var(--link);
        text-decoration:none;
      }
      a:hover{ text-decoration:underline; }
      a:visited{ color:var(--link); }

      .wrap{
        max-width:var(--max);
        margin:0 auto;
        padding:18px 18px 70px;
      }

      /* ===== NAV (sticky) ===== */
      header{
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .bar{
        max-width:var(--max);
        margin:0 auto;
        padding:12px 18px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
        min-height: var(--navH);
      }

      .brand{
        display:flex;
        align-items:center;
        gap:10px;
        font-weight:900;
        letter-spacing:-.02em;
      }

      /* Brand should not inherit link color */
      .brand{ color: var(--fg); text-decoration:none; }
      .brand:hover{ text-decoration:none; }

      .dot{
        width:10px;
        height:10px;
        border-radius:999px;
        background:var(--fg);
        box-shadow:0 0 0 6px var(--card);
      }

      nav{
        display:flex;
        gap:10px;
        flex-wrap:wrap;
        align-items:center;
      }

      .navBtn{
        font-size:13px;
        padding:8px 12px;
        border:1px solid var(--line);
        border-radius:999px;
        background:var(--bg);
        color: var(--fg);
        cursor:pointer;
        transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
      }
      .navBtn:hover{
        border-color:rgba(127,127,127,.35);
        transform:translateY(-1px);
        box-shadow: 0 10px 28px rgba(0,0,0,.08);
        text-decoration:none;
      }

      :root[data-theme="dark"] .navBtn:hover{
        border-color: rgba(255,255,255,.20);
        box-shadow: 0 10px 28px rgba(0,0,0,.35);
      }

      /* ===== Toggle (real switch) ===== */
      .toggle{
        display:flex;
        align-items:center;
        gap:10px;
        padding:6px 10px;
        border:1px solid var(--line);
        border-radius:999px;
        background:var(--bg);
        color: var(--fg);
        cursor:pointer;
        user-select:none;
      }
      .toggleLabel{
        font-size:12px;
        color:var(--muted);
      }
      .switch{
        width:38px;
        height:22px;
        border-radius:999px;
        border:1px solid var(--line);
        background:var(--card);
        position:relative;
      }
      .knob{
        width:18px;
        height:18px;
        border-radius:999px;
        background:var(--fg);
        position:absolute;
        top:50%;
        transform: translateY(-50%);
        left:2px;
        transition:left .18s ease;
      }
      :root[data-theme="dark"] .knob{ left:18px; }

      /* ===== Content spacing under sticky header ===== */
      main{ padding-top: 18px; }

      /* ===== Footer ===== */
      footer{
        margin-top:48px;
        padding-top:16px;
        border-top:1px solid var(--line);
        font-size:12px;
        color:var(--muted);
        display:flex;
        justify-content:space-between;
        gap:12px;
        flex-wrap:wrap;
      }
    </style>
  </head>

  <body>
    <!-- NAV -->
    <header>
      <div class="bar">
        <a href="/" class="brand">
          <span class="dot" aria-hidden="true"></span>
          <span>Pavan Velagaleti</span>
        </a>

        <nav>
          {isHome ? (
            <>
              <a class="navBtn" href="#projects">Projects</a>
              <a class="navBtn" href="#stack">Tools</a>
              <a class="navBtn" href="/about/">About</a>
            </>
          ) : (
            <>
              <a class="navBtn" href="/#projects">Projects</a>
              <a class="navBtn" href="/#stack">Tools</a>
              <a class="navBtn" href="/about/">About</a>
            </>
          )}

          <a class="navBtn" href="/pavan_kushal_velagaleti_Resume_v1.pdf" target="_blank" rel="noreferrer">Resume</a>
          <a class="navBtn" href="mailto:pkv236@nyu.edu">Email</a>

          <button class="toggle" id="themeToggle" type="button" aria-label="Toggle theme">
            <span class="toggleLabel" id="themeLabel">Light</span>
            <span class="switch" aria-hidden="true"><span class="knob"></span></span>
          </button>
        </nav>
      </div>
    </header>

    <div class="wrap">
      <slot />

      <footer>
        <div>© {new Date().getFullYear()} Pavan Velagaleti</div>
        <div>Robotics • Control • Real-time Systems</div>
      </footer>
    </div>

    <script is:inline>
      const key = "theme";
      const root = document.documentElement;
      const btn = document.getElementById("themeToggle");
      const label = document.getElementById("themeLabel");

      const saved = localStorage.getItem(key);
      const prefersDark = window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)").matches;

      const setTheme = (mode) => {
        if (mode === "dark") root.setAttribute("data-theme", "dark");
        else root.removeAttribute("data-theme");
        localStorage.setItem(key, mode);
        label.textContent = (mode === "dark") ? "Dark" : "Light";
      };

      const initial = saved || (prefersDark ? "dark" : "light");
      setTheme(initial);

      btn?.addEventListener("click", () => {
        const isDark = root.getAttribute("data-theme") === "dark";
        setTheme(isDark ? "light" : "dark");
      });
    </script>
  </body>
</html>
  