---
import Layout from "../layouts/Layout.astro";

const NAME = "Pavan Kushal Velagaleti";
const TITLE = "Robotics Software Engineer";
const LOC = "New York, NY";
---

<Layout title={`About — ${NAME}`} description="About Pavan and what he builds">
  <main class="wrap">
    <a class="back" href="/">← Home</a>

    <header class="hero">
      <div>
        <p class="kicker">{TITLE} • {LOC}</p>
        <h1>About</h1>
        <p class="sub">
          I build robotics software where timing, reliability, and system behavior actually matter —
          from real-time control loops and low-latency communication to simulation-first testing and debugging tooling.
        </p>

        <div class="panel">
          <strong>Now</strong>
          <p class="muted">
            MS Mechatronics & Robotics @ NYU. I’m actively looking for Robotics Software Intern / New Grad roles
            focused on real-time control, robotic systems, simulation, and autonomy.
          </p>
          <ul class="list muted">
            <li>Current focus: manipulation + control foundations (FK/IK, Jacobians, tracking control)</li>
            <li>Workflow: design → simulate → evaluate → iterate (repeatable experiments, metrics, failure cases)</li>
          </ul>
        </div>

        <div class="panel">
          <strong>Previously</strong>
          <p class="muted">
            At a surgical robotics startup, I worked on real robot bring-up and demo-critical systems:
            real-time motion/control pipelines, teleoperation behavior, and the communication glue between subsystems.
          </p>
          <ul class="list muted">
            <li>Built and tuned tracking controllers and motion execution pipelines</li>
            <li>Worked with low-latency comms (DDS/CAN + system integration patterns)</li>
            <li>Owned debugging/observability: logs, tools, and failure-mode isolation under pressure</li>
          </ul>
        </div>

        <div class="panel">
          <strong>What I build (selected)</strong>
          <ul class="list muted">
            <li><b>Manipulation simulation</b>: UR10e MuJoCo tasks, interception-style behaviors, controller stability + evaluation loops</li>
            <li><b>Autonomy pipeline</b>: ROS2 + PX4 offboard mission logic with vision-based waypointing</li>
            <li><b>Full-stack mechatronics</b>: vision → embedded control → actuation with encoder feedback (gesture-controlled robotic finger)</li>
          </ul>
        </div>

        <div class="panel">
          <strong>Core strengths</strong>
          <ul class="list muted">
            <li>Real-time control loops, latency + reliability thinking, clean system boundaries</li>
            <li>Robot kinematics and control: FK/IK, frames, Jacobians, tracking</li>
            <li>Simulation-first workflows: reproducible testing, metrics, debugging tools</li>
            <li>Systems integration: comms, embedded interfaces, safety constraints</li>
          </ul>
        </div>

        <div class="actions">
          <a class="btn" href="/#projects">Projects</a>
          <a class="btn" href="/stack/">Tools & Stack</a>
          <a class="btn" href="mailto:pkv236@nyu.edu">Email</a>
        </div>
      </div>

      <aside class="card">
        <img class="pf" src="/profile.jpg" alt="Pavan Velagaleti" />
        <div class="pad">
          <div class="name">{NAME}</div>
          <div class="muted">Robotics • Control • Real-time Systems</div>

          <div class="actions small">
            <a class="btn" href="https://github.com/wukongxzero" target="_blank" rel="noreferrer">GitHub</a>
            <a class="btn" href="https://www.linkedin.com/in/pavan-kushal-velagaleti/" target="_blank" rel="noreferrer">LinkedIn</a>
          </div>
        </div>
      </aside>
    </header>
  </main>

  <style>
    .wrap{max-width:1100px;margin:0 auto;padding:18px 20px 60px}
    .back{display:inline-block;margin:8px 0 16px;font-size:13px;opacity:.75;text-decoration:none;color:var(--fg)}
    .kicker{font-size:13px;opacity:.7}
    h1{font-size:44px;line-height:1.05;margin:6px 0 8px;letter-spacing:-.04em}
    .sub{max-width:75ch;opacity:.85}
    .hero{display:grid;grid-template-columns:1.35fr .65fr;gap:18px;align-items:start}
    @media (max-width:900px){ .hero{grid-template-columns:1fr} }
    .panel{margin-top:12px;padding:14px;border:1px solid var(--line);border-radius:16px;background:var(--bg);box-shadow:var(--shadow)}
    .list{margin:8px 0 0;padding-left:18px}
    .list li{margin:7px 0}
    .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .actions.small{margin-top:12px}
    .btn{font-size:13px;padding:9px 12px;border-radius:999px;border:1px solid var(--line);background:var(--bg);color:var(--fg);text-decoration:none}
    .btn:hover{border-color:rgba(127,127,127,.45);box-shadow:0 10px 28px rgba(0,0,0,.10)}
    .card{border:1px solid var(--line);border-radius:22px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow)}
    .pf{width:100%;height:260px;object-fit:cover;object-position:center 15%;display:block;background:var(--card)}
    .pad{padding:14px 16px 16px}
    .name{font-weight:900;letter-spacing:-.02em}
    .muted{color:var(--muted)}
  </style>
</Layout>
