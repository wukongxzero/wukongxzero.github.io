---
import { projects } from "../data/projects.js";

const tier1 = projects.filter(p => p.tier === 1);
const tier2 = projects.filter(p => p.tier === 2);
const tier3 = projects.filter(p => p.tier === 3);

const fallbackHero = "/projects/_placeholder/hero.jpg";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pavan Kushal Velagaleti | Robotics</title>
  <style>
    html { scroll-behavior: smooth; }
    body { margin:0; font-family: system-ui; background:#0b1220; color:#e6edf3; }
    a { color:#58a6ff; }
    nav { position:sticky; top:0; z-index:50; background:rgba(11,18,32,.75); backdrop-filter: blur(10px); border-bottom:1px solid #1f2937; }
    .bar { max-width:1100px; margin:0 auto; padding:14px 20px; display:flex; gap:10px; align-items:center; }
    .pill { padding:8px 12px; border:1px solid #243042; border-radius:999px; background:#0f172a; color:#e6edf3; text-decoration:none; opacity:.92; }
    .pill:hover { opacity:1; }
    .wrap { max-width:1100px; margin:0 auto; padding:44px 20px; }
    .hero { display:grid; grid-template-columns: 1.2fr .8fr; gap:18px; align-items:center; }
    @media (max-width:900px){ .hero{grid-template-columns:1fr;} }
    h1 { font-size:44px; margin:0 0 10px 0; letter-spacing:-.02em; }
    .sub { opacity:.8; max-width:820px; line-height:1.6; }
    section { padding-top:80px; margin-top:-80px; }
    .title { font-size:26px; margin:26px 0 8px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; margin-top:14px; }
    .card { border:1px solid #1f2937; background:#0f172a; border-radius:16px; overflow:hidden; text-decoration:none; color:inherit; }
    .card img { width:100%; height:170px; object-fit:cover; display:block; background:#111827; }
    .pad { padding:14px; }
    .tags { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
    .tag { font-size:12px; padding:4px 8px; border-radius:999px; background:#111827; border:1px solid #243042; opacity:.92; }
    .panel { border:1px solid #1f2937; border-radius:16px; background:#0f172a; padding:14px; }
    .muted { opacity:.75; }
    .skills { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; margin-top:14px; }
  </style>
</head>

<body>
  <nav>
    <div class="bar">
      <strong style="margin-right:6px;">Pavan</strong>
      <a class="pill" href="#projects">Projects</a>
      <a class="pill" href="#skills">Tools & Skills</a>
      <a class="pill" href="#about">About</a>
      <a class="pill" href="#contact">Contact</a>
      <div style="flex:1"></div>
      <a class="pill" href="/projects/">All Projects</a>
      <a class="pill" href="https://github.com/wukongxzero" target="_blank">GitHub</a>
      <a class="pill" href="https://www.linkedin.com/" target="_blank">LinkedIn</a>
    </div>
  </nav>

  <div class="wrap hero">
    <div>
      <h1>Pavan Kushal Velagaleti</h1>
      <p class="sub">Robotics & Mechatronics — real-time control, embedded systems, simulation, and autonomy.</p>

      <div class="panel" style="margin-top:14px;">
        <div style="font-weight:750;">What I’m looking for</div>
        <div class="muted" style="margin-top:6px; line-height:1.6;">
          Robotics Software Intern / New Grad — real-time control, robotic systems, simulation, autonomy.
        </div>
      </div>

      <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;">
        <a class="pill" href="#projects">View Projects ↓</a>
        <a class="pill" href="/projects/">Projects Page</a>
        <a class="pill" href="#contact">Contact</a>
      </div>
    </div>

    <div class="panel">
      <div style="font-weight:750; margin-bottom:10px;">Profile</div>
      <img
        src="/profile.jpg"
        alt="Pavan"
        style="width:100%; border-radius:14px; border:1px solid #1f2937; background:#111827;"
        onerror={`this.src='${fallbackHero}'`}
      />
      <div class="muted" style="margin-top:10px; font-size:14px;">
        Add <code>public/profile.jpg</code> later. Placeholder is fine for now.
      </div>
    </div>
  </div>

  <div class="wrap">
    <section id="projects">
      <div class="title">Projects</div>
      <p class="sub">Tiered by impact. Click any card for the “Problem → Approach → Results” story.</p>

      <div style="margin-top:14px; font-weight:800;">Tier 1 — strongest proof</div>
      <div class="grid">
        {tier1.map(p => (
          <a class="card" href={`/projects/${p.slug}/`}>
            <img src={p.hero} alt={p.title} onerror={`this.src='${fallbackHero}'`} />
            <div class="pad">
              <div style="display:flex; justify-content:space-between; gap:10px;">
                <div style="font-weight:800;">{p.title}</div>
                <div class="muted" style="font-size:12px;">{p.year}</div>
              </div>
              <div class="muted" style="margin-top:6px; font-size:14px;">{p.subtitle}</div>
              <div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
            </div>
          </a>
        ))}
      </div>

      <div style="margin-top:22px; font-weight:800;">Tier 2 — solid builds</div>
      <div class="grid">
        {tier2.map(p => (
          <a class="card" href={`/projects/${p.slug}/`}>
            <img src={p.hero} alt={p.title} onerror={`this.src='${fallbackHero}'`} />
            <div class="pad">
              <div style="display:flex; justify-content:space-between; gap:10px;">
                <div style="font-weight:800;">{p.title}</div>
                <div class="muted" style="font-size:12px;">{p.year}</div>
              </div>
              <div class="muted" style="margin-top:6px; font-size:14px;">{p.subtitle}</div>
              <div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
            </div>
          </a>
        ))}
      </div>

      <div style="margin-top:22px; font-weight:800;">Tier 3 — research / WIP</div>
      <div class="grid">
        {tier3.map(p => (
          <a class="card" href={`/projects/${p.slug}/`}>
            <img src={p.hero} alt={p.title} onerror={`this.src='${fallbackHero}'`} />
            <div class="pad">
              <div style="display:flex; justify-content:space-between; gap:10px;">
                <div style="font-weight:800;">{p.title}</div>
                <div class="muted" style="font-size:12px;">{p.year}</div>
              </div>
              <div class="muted" style="margin-top:6px; font-size:14px;">{p.subtitle}</div>
              <div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="skills">
      <div class="title">Tools & Skills</div>
      <p class="sub">Only the tools I can back up with projects.</p>

      <div class="skills">
        <div class="panel">
          <div style="font-weight:800;">Control</div>
          <ul style="margin:10px 0 0; padding-left:18px;">
            <li>PID/PD, tracking, tuning tradeoffs</li>
            <li>Task-space / joint-space thinking</li>
            <li>Stability-minded debugging</li>
          </ul>
        </div>

        <div class="panel">
          <div style="font-weight:800;">Robotics Software</div>
          <ul style="margin:10px 0 0; padding-left:18px;">
            <li>C++ / Python</li>
            <li>System integration mindset</li>
            <li>Simulation-first development</li>
          </ul>
        </div>

        <div class="panel">
          <div style="font-weight:800;">Embedded / Systems</div>
          <ul style="margin:10px 0 0; padding-left:18px;">
            <li>Sensor → controller → actuator pipelines</li>
            <li>CAN/DDS concepts, serial integration</li>
            <li>Reliability + debugging tooling</li>
          </ul>
        </div>

        <div class="panel">
          <div style="font-weight:800;">Simulation</div>
          <ul style="margin:10px 0 0; padding-left:18px;">
            <li>MuJoCo environments + controllers</li>
            <li>Evaluation scripts + repeatability</li>
            <li>Failure modes + tuning workflows</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="title">About</div>
      <p class="sub">
        I’m building toward a career where I ship robotic systems end-to-end — control + embedded + simulation + integration.
        I care about reliability, real-time behavior, and explaining engineering tradeoffs clearly.
      </p>
      <p class="sub muted">Goal: get hired as an intuitive roboticist by showing real proof of work.</p>
    </section>

    <section id="contact">
      <div class="title">Contact</div>
      <div class="panel">
        <div class="muted">Replace these with your real links:</div>
        <div style="margin-top:10px; line-height:1.8;">
          <div>Email: <b>ADD_EMAIL_HERE</b></div>
          <div>GitHub: <a href="https://github.com/wukongxzero" target="_blank">github.com/wukongxzero</a></div>
          <div>LinkedIn: <a href="https://www.linkedin.com/" target="_blank">linkedin.com/in/...</a></div>
        </div>
      </div>
    </section>
  </div>
</body>
</html>
