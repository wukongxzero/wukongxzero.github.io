---
import { projects } from "../data/projects.js";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pavan Kushal Velagaleti</title>

  <style>
    html { scroll-behavior: smooth; }
    body { margin:0; font-family: system-ui; background:#0b1220; color:#e6edf3; }
    .wrap { max-width:1100px; margin:0 auto; padding:40px 20px; }
    nav { position: sticky; top:0; z-index:50; backdrop-filter: blur(10px); background: rgba(11,18,32,.75); border-bottom:1px solid #1f2937; }
    nav .bar { max-width:1100px; margin:0 auto; padding:14px 20px; display:flex; gap:12px; align-items:center; }
    nav a { color:#e6edf3; text-decoration:none; opacity:.85; }
    nav a:hover { opacity:1; }
    .pill { padding:8px 12px; border:1px solid #243042; border-radius:999px; background:#0f172a; }
    .hero h1 { font-size:44px; margin:8px 0; letter-spacing:-.02em; }
    .sub { opacity:.8; max-width:820px; line-height:1.6; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:18px; margin-top:20px; }
    .card { border:1px solid #1f2937; background:#0f172a; border-radius:16px; overflow:hidden; text-decoration:none; color:inherit; transform: translateY(10px); opacity:0; transition: .45s ease; }
    .card.reveal { transform: translateY(0); opacity:1; }
    .card img { width:100%; height:180px; object-fit:cover; display:block; background:#111827; }
    .card .pad { padding:14px; }
    .tags { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
    .tag { font-size:12px; padding:4px 8px; border-radius:999px; background:#111827; border:1px solid #243042; opacity:.9; }
    section { padding-top:80px; margin-top:-80px; }
    .sectionTitle { font-size:26px; margin:28px 0 8px; }
    .btnrow { display:flex; gap:10px; flex-wrap:wrap; margin-top:18px; }
  </style>
</head>

<body>
  <nav>
    <div class="bar">
      <strong style="margin-right:8px;">Pavan</strong>
      <a class="pill" href="#projects">Projects</a>
      <a class="pill" href="#about">About</a>
      <a class="pill" href="#contact">Contact</a>
      <div style="flex:1"></div>
      <a class="pill" href="https://github.com/wukongxzero" target="_blank">GitHub</a>
      <a class="pill" href="https://www.linkedin.com/" target="_blank">LinkedIn</a>
    </div>
  </nav>

  <div class="wrap hero">
    <h1>Pavan Kushal Velagaleti</h1>
    <p class="sub">Robotics & Mechatronics — real-time control, embedded systems, simulation, and autonomy.</p>

    <div class="btnrow">
      <a class="pill" href="#projects">View Projects ↓</a>
      <a class="pill" href="/projects/">Projects Page</a>
    </div>
  </div>

  <div class="wrap">
    <section id="projects">
      <div class="sectionTitle">Projects</div>
      <p class="sub">A quick snapshot of what I build. Click any card for full details.</p>

      <div class="grid">
        {projects.map(p => (
          <a class="card" href={`/projects/${p.slug}/`}>
            <img src={p.hero} alt={p.title} />
            <div class="pad">
              <div style="display:flex; justify-content:space-between; gap:10px;">
                <div style="font-weight:750;">{p.title}</div>
                <div style="opacity:.65; font-size:12px;">{p.year}</div>
              </div>
              <div style="opacity:.85; margin-top:6px; font-size:14px;">{p.subtitle}</div>
              <div class="tags">
                {p.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="about">
      <div class="sectionTitle">About</div>
      <p class="sub">
        I build robotic systems end-to-end: control, real-time communication, embedded integration, and simulation.
        Currently pursuing an M.S. in Mechatronics & Robotics at NYU Tandon.
      </p>
    </section>

    <section id="contact">
      <div class="sectionTitle">Contact</div>
      <p class="sub">
        Email: <b>YOUR_EMAIL</b> • New York, USA • Open to Robotics Software roles/internships
      </p>
    </section>
  </div>

  <script>
    const cards = document.querySelectorAll(".card");
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add("reveal"); });
    }, { threshold: 0.15 });
    cards.forEach(c => io.observe(c));
  </script>
</body>
</html>
