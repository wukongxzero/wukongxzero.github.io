---
import { projects } from "../../data/projects.js";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Projects | Pavan</title>
</head>

<body style="font-family:system-ui; margin:0; background:#0b1220; color:#e6edf3;">
  <main style="max-width:900px; margin:0 auto; padding:48px 20px;">
    <a href="/" style="color:#58a6ff; text-decoration:none;">← Home</a>
    <h1 style="margin:18px 0 10px 0;">Projects</h1>
    <p style="opacity:.8;">Click a project to open its detail page.</p>

    <ul style="padding-left:18px;">
      {projects.map(p => (
        <li style="margin:10px 0;">
          <a href={`/projects/${p.slug}/`} style="color:#58a6ff; text-decoration:none;">
            {p.title}
          </a>
          <span style="opacity:.7;"> — {p.subtitle}</span>
        </li>
      ))}
    </ul>
  </main>
</body>
</html>
