---
import { projects } from "../../data/projects.js";
const fallbackHero = "/projects/_placeholder/hero.jpg";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Projects | Pavan</title>
  <style>
    body { margin:0; font-family: system-ui; background:#0b1220; color:#e6edf3; }
    a { color:#58a6ff; }
    .wrap { max-width:1100px; margin:0 auto; padding:44px 20px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; margin-top:14px; }
    .card { border:1px solid #1f2937; background:#0f172a; border-radius:16px; overflow:hidden; text-decoration:none; color:inherit; }
    .card img { width:100%; height:170px; object-fit:cover; display:block; background:#111827; }
    .pad { padding:14px; }
    .tags { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
    .tag { font-size:12px; padding:4px 8px; border-radius:999px; background:#111827; border:1px solid #243042; opacity:.92; }
    .muted { opacity:.75; }
  </style>
</head>
<body>
  <main class="wrap">
    <a href="/" style="text-decoration:none;">← Home</a>
    <h1 style="margin:18px 0 8px;">Projects</h1>
    <p class="muted" style="margin:0;">Click any project to see the “Problem → Approach → Results” story.</p>

    <div class="grid">
      {projects.map(p => (
        <a class="card" href={`/projects/${p.slug}/`}>
          <img src={p.hero} alt={p.title} onerror={`this.src='${fallbackHero}'`} />
          <div class="pad">
            <div style="display:flex; justify-content:space-between; gap:10px;">
              <div style="font-weight:800;">{p.title}</div>
              <div class="muted" style="font-size:12px;">Tier {p.tier}</div>
            </div>
            <div class="muted" style="margin-top:6px; font-size:14px;">{p.subtitle}</div>
            <div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
          </div>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
