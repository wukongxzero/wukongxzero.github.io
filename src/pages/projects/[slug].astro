---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects.js";

export const prerender = true;

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug);

if (!project) throw new Error(`Project not found: ${slug}`);

const hasHero = (p) => typeof p?.hero === "string" && p.hero.trim().length > 0;

// If you want, mark projects that have diagram-like heroes in projects.js:
// heroFit: "contain" | "cover"
const heroFit = project.heroFit ?? "cover";
---

<Layout title={`${project.title} — Portfolio`} description={project.subtitle}>
  <main class="page">
    <a class="back" href="/">← Home</a>

    <header class="top">
      <div>
        <h1>{project.title}</h1>
        <p class="sub">{project.subtitle}</p>

        <div class="meta">
          {project.year ? <span class="pill">{project.year}</span> : null}
          {typeof project.tier !== "undefined" ? <span class="pill">Tier {project.tier}</span> : null}
          {project.role ? <span class="pill">{project.role}</span> : null}
        </div>

        <div class="links">
          {project.links?.github ? (
            <a class="btn" href={project.links.github} target="_blank" rel="noreferrer">GitHub</a>
          ) : null}

          {project.links?.video ? (
            <a class="btn" href={project.links.video} target="_blank" rel="noreferrer">Video</a>
          ) : null}

          {project.links?.website ? (
            <a class="btn" href={project.links.website} target="_blank" rel="noreferrer">Company Website</a>
          ) : null}
        </div>
      </div>

      <div class="hero">
        {hasHero(project) ? (
          <img
            src={project.hero}
            alt={project.title}
            loading="eager"
            style={`object-fit:${heroFit};`}
          />
        ) : (
          <div class="ph">Add hero image</div>
        )}
      </div>
    </header>

    {project.architectureNote ? (
      <div class="note">
        <strong>Architecture note:</strong> {project.architectureNote}
      </div>
    ) : null}

    {project.confidentialityNote ? (
      <div class="note" style="margin-top:10px;">
        <strong>Confidentiality:</strong> {project.confidentialityNote}
      </div>
    ) : null}

    <section class="section">
      <h2>What I built</h2>
      <p class="txt">{project.systemOverview ?? project.problem ?? "—"}</p>
    </section>

    {project.problem ? (
      <section class="section">
        <h2>Problem</h2>
        <p class="txt">{project.problem}</p>
      </section>
    ) : null}

    {project.approach?.length ? (
      <section class="section">
        <h2>Approach</h2>
        <ul class="list">
          {project.approach.map((x) => <li>{x}</li>)}
        </ul>
      </section>
    ) : null}

    {project.decisions?.length ? (
      <section class="section">
        <h2>Engineering decisions</h2>
        <div class="decGrid">
          {project.decisions.map((d) => (
            <div class="decCard">
              <div class="decTitle">{d.title}</div>
              <div class="decDetail">{d.detail}</div>
            </div>
          ))}
        </div>
      </section>
    ) : null}

    {project.ownership?.length ? (
      <section class="section">
        <h2>Ownership</h2>
        <ul class="list">
          {project.ownership.map((x) => <li>{x}</li>)}
        </ul>
      </section>
    ) : null}

    {project.results?.length ? (
      <section class="section">
        <h2>Results</h2>
        <ul class="list">
          {project.results.map((x) => <li><strong>{x}</strong></li>)}
        </ul>
      </section>
    ) : null}

    {project.gallery?.length ? (
      <section class="section" data-gallery>
        <div class="galTop">
          <h2 class="h2">Gallery</h2>
          <div class="galCtrls">
            <button class="galBtn" type="button" data-prev aria-label="Previous">←</button>
            <button class="galBtn" type="button" data-next aria-label="Next">→</button>
          </div>
        </div>

        <div class="galCarousel" data-carousel>
          {project.gallery.map((g, i) => (
            <button
              class={`galSlide ${i === 0 ? "isActive" : ""}`}
              type="button"
              data-slide
              data-src={g.src}
              data-title={g.title}
              data-caption={g.caption ?? ""}
              aria-label={`Open image: ${g.title}`}
            >
              <img src={g.src} alt={g.title} loading="lazy" />
              <div class="galMeta">
                <div class="capT">{g.title}</div>
                {g.caption ? <div class="capD">{g.caption}</div> : null}
                <div class="capIdx">{i + 1} / {project.gallery.length}</div>
              </div>
            </button>
          ))}
        </div>

        <!-- LIGHTBOX -->
        <div class="lightbox" data-lightbox aria-hidden="true">
          <div class="lbBackdrop" data-close></div>

          <div class="lbPanel" role="dialog" aria-modal="true" aria-label="Media viewer">
            <button class="lbClose" type="button" data-close aria-label="Close">✕</button>

            <div class="lbMedia">
              <img class="lbImg" data-lb-img alt="" />
            </div>

            <div class="lbText">
              <div class="lbTitle" data-lb-title></div>
              <div class="lbCaption" data-lb-caption></div>
            </div>
          </div>
        </div>
      </section>
    ) : null}

    {project.tags?.length ? (
      <section class="section">
        <h2>Stack</h2>
        <div class="tags">
          {project.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </section>
    ) : null}
  </main>

  <style>
    .page{max-width:980px;margin:0 auto;padding:10px 0 40px}

    .back{
      display:inline-block;margin:6px 0 14px;
      font-size:13px;opacity:.75;text-decoration:none;color:var(--fg)
    }
    .back:hover{opacity:1}

    h1,h2{letter-spacing:-.03em}
    h1{margin:0 0 8px;font-size:40px;line-height:1.05}
    h2{margin:0 0 10px;font-size:18px}
    .sub{margin:0 0 10px;color:var(--muted);max-width:80ch}

    .top{display:grid;grid-template-columns:1fr 380px;gap:16px;align-items:start}

    .hero{
      border:1px solid var(--line);
      border-radius:18px;
      overflow:hidden;
      background:var(--bg);
      box-shadow:var(--shadow)
    }
    .hero img{
      width:100%;
      height:260px;
      display:block;
      background:var(--card)
    }
    .ph{height:260px;display:grid;place-items:center;background:var(--card);color:var(--muted)}

    .meta{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
    .pill{
      font-size:11px;
      border:1px solid var(--line);
      border-radius:999px;
      padding:4px 8px;
      color:var(--fg);
      background:var(--card);
    }

    .links{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
    .btn{
      font-size:13px;
      border:1px solid var(--line);
      border-radius:999px;
      padding:8px 10px;
      background:var(--bg);
      color:var(--fg);
      text-decoration:none;
      transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .btn:hover{
      transform:translateY(-1px);
      border-color:rgba(127,127,127,.45);
      box-shadow:0 10px 28px rgba(0,0,0,.10);
    }

    .note{
      margin-top:10px;
      padding:10px 12px;
      border-radius:14px;
      border:1px solid var(--line);
      background:var(--card);
      color:var(--muted);
      font-size:13px;
    }

    .section{margin-top:22px}
    .txt{color:var(--fg);opacity:.92;max-width:85ch}
    .list{margin:0;padding-left:18px;color:var(--fg);opacity:.92}
    .list li{margin:8px 0}

    .decGrid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:12px;
      margin-top:10px;
    }
    @media (max-width:980px){ .decGrid{grid-template-columns:1fr} }
    .decCard{
      border:1px solid var(--line);
      border-radius:16px;
      background:var(--bg);
      padding:12px 12px 13px;
      box-shadow:var(--shadow);
      transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
    }
    .decCard:hover{
      transform:translateY(-2px);
      border-color:rgba(127,127,127,.45);
      box-shadow:0 20px 50px rgba(0,0,0,.18);
    }
    .decTitle{font-weight:900;margin-bottom:6px}
    .decDetail{color:var(--muted);font-size:13px;line-height:1.5}

    .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
    .tag{
      font-size:12px;
      border:1px solid var(--line);
      border-radius:999px;
      padding:5px 9px;
      background:var(--card);
      color:var(--fg);
      opacity:.95
    }

    /* ===== GALLERY CAROUSEL ===== */
    .h2{ margin:0; }

    .galTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:10px;
    }

    .galCtrls{ display:flex; gap:8px; }
    .galBtn{
      width:38px;height:38px;
      border-radius:999px;
      border:1px solid var(--line);
      background:var(--card);
      color:var(--fg);
      cursor:pointer;
      transition:transform .15s ease, border-color .15s ease, box-shadow .15s ease;
    }
    .galBtn:hover{
      transform: translateY(-1px);
      border-color: rgba(127,127,127,.45);
      box-shadow:0 10px 28px rgba(0,0,0,.12);
    }

    /* Reserve space so it feels stable */
    .galCarousel{
      min-height: 520px;
    }

    .galSlide{
      width:100%;
      border:1px solid var(--line);
      border-radius:18px;
      overflow:hidden;
      background:var(--bg);
      box-shadow:var(--shadow);
      padding:0;
      display:none;
      cursor: zoom-in;
      text-align:left;
      color:inherit;
      transition:transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .galSlide:hover{
      transform:translateY(-2px);
      border-color: rgba(127,127,127,.45);
      box-shadow:0 20px 50px rgba(0,0,0,.18);
    }
    .galSlide.isActive{ display:block; }

    .galSlide img{
      width:100%;
      height:430px;
      display:block;
      background:var(--card);
      object-fit:contain; /* diagrams look correct */
    }

    .galMeta{
      padding:12px 14px 14px;
      border-top:1px solid var(--line);
    }
    .capT{font-weight:900;font-size:13px;margin-bottom:4px}
    .capD{font-size:12px;color:var(--muted)}
    .capIdx{font-size:12px;color:var(--muted);margin-top:8px;opacity:.8}

    /* LIGHTBOX */
    .lightbox{position:fixed;inset:0;display:none;z-index:9999}
    .lightbox.show{ display:block; }
    .lbBackdrop{position:absolute;inset:0;background: rgba(0,0,0,.55)}

    .lbPanel{
      position:absolute;
      inset: 5vh 4vw;
      border-radius:18px;
      background: var(--bg);
      border:1px solid var(--line);
      box-shadow: 0 30px 90px rgba(0,0,0,.45);
      overflow:hidden;
      display:flex;
      flex-direction:column;
    }

    .lbClose{
      position:absolute;
      top:10px; right:10px;
      width:38px; height:38px;
      border-radius:999px;
      border:1px solid var(--line);
      background: var(--card);
      color: var(--fg);
      cursor:pointer;
      z-index:2;
    }

    .lbMedia{
      flex:1;
      display:grid;
      place-items:center;
      padding: 18px;
      background: var(--card);
    }

    .lbImg{
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      border-radius: 12px;
      background: var(--bg);
    }

    .lbText{
      padding: 12px 14px 14px;
      border-top:1px solid var(--line);
    }
    .lbTitle{ font-weight:900; }
    .lbCaption{ color:var(--muted); margin-top:4px; font-size:13px; line-height:1.45; }

    html.lbOpen, html.lbOpen body{ overflow:hidden; }

    @media (max-width:980px){
      .top{grid-template-columns:1fr}
      .hero img,.ph{height:240px}
      .galSlide img{ height:260px; }
      .galCarousel{ min-height: 360px; }
      .lbPanel{ inset: 4vh 3vw; }
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-gallery]");
      if (!root) return;

      const carousel = root.querySelector("[data-carousel]");
      if (!carousel) return;

      const slides = Array.from(carousel.querySelectorAll("[data-slide]"));
      const prev = root.querySelector("[data-prev]");
      const next = root.querySelector("[data-next]");

      if (!slides.length) return;

      let index = 0;
      let timer = null;

      const show = (i) => {
        index = (i + slides.length) % slides.length;
        slides.forEach((s, k) => s.classList.toggle("isActive", k === index));
      };

      const start = () => {
        stop();
        if (slides.length > 1) timer = setInterval(() => show(index + 1), 4500);
      };

      const stop = () => {
        if (timer) clearInterval(timer);
        timer = null;
      };

      prev?.addEventListener("click", () => { show(index - 1); start(); });
      next?.addEventListener("click", () => { show(index + 1); start(); });

      carousel.addEventListener("mouseenter", stop);
      carousel.addEventListener("mouseleave", start);

      // Lightbox
      const lb = root.querySelector("[data-lightbox]");
      const lbImg = root.querySelector("[data-lb-img]");
      const lbTitle = root.querySelector("[data-lb-title]");
      const lbCaption = root.querySelector("[data-lb-caption]");
      const closeEls = lb ? lb.querySelectorAll("[data-close]") : [];

      const openLB = (src, title, caption) => {
        if (!lb || !lbImg) return;

        // GIFs reload reliably
        const isGif = /\.gif(\?.*)?$/i.test(src);
        lbImg.src = isGif ? `${src}${src.includes("?") ? "&" : "?"}t=${Date.now()}` : src;

        lbImg.alt = title || "Gallery media";
        if (lbTitle) lbTitle.textContent = title || "";
        if (lbCaption) lbCaption.textContent = caption || "";

        lb.classList.add("show");
        lb.setAttribute("aria-hidden", "false");
        document.documentElement.classList.add("lbOpen");
      };

      const closeLB = () => {
        if (!lb || !lbImg) return;
        lb.classList.remove("show");
        lb.setAttribute("aria-hidden", "true");
        document.documentElement.classList.remove("lbOpen");
        lbImg.src = "";
      };

      slides.forEach((s) => {
        s.addEventListener("click", () => openLB(s.dataset.src, s.dataset.title, s.dataset.caption));
      });

      closeEls.forEach((el) => el.addEventListener("click", closeLB));

      window.addEventListener("keydown", (e) => {
        const isOpen = document.documentElement.classList.contains("lbOpen");

        if (!isOpen) {
          if (e.key === "ArrowLeft") { show(index - 1); start(); }
          if (e.key === "ArrowRight") { show(index + 1); start(); }
          return;
        }

        if (e.key === "Escape") closeLB();
        if (e.key === "ArrowLeft") show(index - 1);
        if (e.key === "ArrowRight") show(index + 1);
      });

      // Init
      show(0);
      start();
    })();
  </script>
</Layout>
