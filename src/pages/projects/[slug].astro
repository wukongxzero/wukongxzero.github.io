---
import { projects } from "../../data/projects.js";

// Static site (GitHub Pages) needs this:
export const prerender = true;

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{project.title} | Pavan</title>
</head>

<body style="font-family: system-ui; margin:0; background:#0b1220; color:#e6edf3;">
  <main style="max-width:900px; margin:0 auto; padding:48px 20px;">
    <a href="/projects" style="color:#58a6ff; text-decoration:none;">← Back to projects</a>

    <h1 style="margin:18px 0 8px 0;">{project.title}</h1>
    <p style="opacity:.85; margin-top:0;">{project.subtitle}</p>

    <img src={project.hero} alt={project.title} style="width:100%; border-radius:16px; border:1px solid #1f2937; margin:18px 0;" />

    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px;">
      {project.tags.map(t => (
        <span style="font-size:12px; padding:6px 10px; border-radius:999px; background:#111827; border:1px solid #243042;">{t}</span>
      ))}
    </div>

    <h2 style="margin:18px 0 10px 0;">Highlights</h2>
    <ul>
      {project.bullets.map(b => <li style="margin:8px 0; opacity:.95;">{b}</li>)}
    </ul>

    <h2 style="margin:26px 0 10px 0;">Links</h2>
    <ul>
      <li>GitHub: {project.links.github ? <a href={project.links.github} target="_blank" style="color:#58a6ff;">Open</a> : <span style="opacity:.7;">(add later)</span>}</li>
      <li>Video: {project.links.video ? <a href={project.links.video} target="_blank" style="color:#58a6ff;">Watch</a> : <span style="opacity:.7;">(add later)</span>}</li>
    </ul>
  </main>
</body>
</html>
